# Modified 2026-10-30 by slavalevski-tech; AGPL-3.0-only.
# First stage follows upstream docker/Dockerfile with RAM-backed CUDA extraction.
# BuildKit is required; no private base image is needed.
# Kindi runtime image. CUDA 10.2 supports the Quadro K420 (sm_30) and the GTX 1080 (sm_61).
# CUDA 10.2 is the last toolkit with Kepler sm_30 support, and CuPy 9.6 the last CuPy built for it; the host needs
# the NVIDIA 470 driver (the last branch that supports Kepler) and the NVIDIA Container Toolkit.
#
#   docker build -t kindi:0.1.0 -f docker/Dockerfile .
#   docker run -d --name kindi --gpus all -p 127.0.0.1:8093:8093 -v $HOME/.kindi:/data kindi:0.1.0
FROM ubuntu:18.04 AS kindi_base

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates libxml2 python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# CUDA 10.2 toolkit (runtime libraries, cuBLAS, NVRTC - Kindi compiles its kernels at first start)
RUN --mount=type=tmpfs,target=/tmp cd /tmp \
    && wget -q --tries=5 --timeout=30 https://developer.download.nvidia.com/compute/cuda/10.2/Prod/local_installers/cuda_10.2.89_440.33.01_linux.run \
    && sh cuda_10.2.89_440.33.01_linux.run --silent --toolkit --no-opengl-libs --override \
    && rm -f cuda_10.2.89_440.33.01_linux.run \
    && rm -rf /usr/local/cuda-10.2/doc /usr/local/cuda-10.2/samples /usr/local/cuda-10.2/nsight* \
              /usr/local/cuda-10.2/libnsight /usr/local/cuda-10.2/libnvvp /usr/local/cuda-10.2/extras
ENV PATH=/usr/local/cuda-10.2/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda-10.2/lib64 \
    LANG=C.UTF-8 LC_ALL=C.UTF-8 PYTHONUNBUFFERED=1

# (CuPy's fastrlock dependency builds from source on Python 3.6: the compiler is installed for this step only)
RUN apt-get update && apt-get install -y --no-install-recommends gcc python3-dev \
    && python3 -m pip install --no-cache-dir --upgrade "pip<21.4" "setuptools<60" \
    && python3 -m pip install --no-cache-dir "numpy==1.19.5" "fastrlock==0.8.3" "cupy-cuda102==9.6.0" \
       "fastapi==0.79.1" "uvicorn==0.16.0" "pydantic==1.9.2" "Jinja2==3.0.3" "MarkupSafe==2.0.1" \
    && apt-get purge -y python3-dev && apt-get autoremove -y \
    && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*

COPY kindi /opt/kindi/kindi
WORKDIR /opt/kindi
# /data holds the converted model (pack/) and the cache (state/); see docs/DOCKER.md
ENV KINDI_PACK=/data/pack KINDI_STATE_DIR=/data/state KINDI_HOST=0.0.0.0
VOLUME ["/data"]
EXPOSE 8093
ENTRYPOINT ["python3", "-m", "kindi"]
CMD ["serve"]

FROM kindi_base
LABEL org.opencontainers.image.title="Kindi 0.3.0 + Lightning backend V3 for K6000" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.description="Isolated native CUDA 10.2 / sm_35 Lightning adapter; model mounted separately"
WORKDIR /opt/lightning
COPY . /opt/lightning/
ENV PYTHONPATH=/opt/lightning PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 \
    CUPY_CACHE_DIR=/workspace/state/kernels CUDA_CACHE_PATH=/workspace/state/kernels/driver \
    CUDA_CACHE_MAXSIZE=536870912
ENTRYPOINT ["python3", "/opt/lightning/release_entry.py"]
CMD ["serve"]

RUN python3 scripts/check_release.py
