[Unit]
Description=Kindi Bridge scheduler and knowledge indexer
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/kindi-bridge-dev
ExecStart=%h/kindi-bridge-dev/.venv/bin/kindi-bridge serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
