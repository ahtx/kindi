# Kindi code image for AMD GPUs (ROCm): the Kindi source on top of the dependency base image
# (docker/base/Dockerfile.rocm). Rebuild this one after every code change - it takes seconds. See docs/DOCKER.md.
#
#   docker/build-code.sh rocm   (or: docker build -t kindi-rocm:0.3.0 -f docker/Dockerfile.rocm .)
#   docker run -d --name kindi --device /dev/kfd --device /dev/dri --group-add video --group-add render \
#       --security-opt seccomp=unconfined -e HSA_OVERRIDE_GFX_VERSION=11.0.2 \
#       -p 127.0.0.1:8093:8093 -v $HOME/.kindi:/data kindi-rocm:0.3.0
ARG BASE_IMAGE=kindi-base-rocm:0.3.0
FROM ${BASE_IMAGE}

COPY kindi /opt/kindi/kindi
WORKDIR /opt/kindi
# /data holds the converted model (pack/) and the cache (state/); see docs/DOCKER.md
ENV KINDI_PACK=/data/pack KINDI_STATE_DIR=/data/state KINDI_HOST=0.0.0.0 CUPY_CACHE_DIR=/data/state/cupy
VOLUME ["/data"]
EXPOSE 8093
ENTRYPOINT ["python3", "-m", "kindi"]
CMD ["serve"]
